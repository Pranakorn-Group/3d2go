generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum Currency {
  THB
  SGD
}

enum PurchaseStatus {
  PLACED
  SHIPPED
  RECEIVED
  CANCELLED
}

enum SaleStatus {
  RESERVED
  COMPLETED
  CANCELLED
}

enum MovementKind {
  RECEIVE
  SALE
  ADJUST
  /// A roll taken out of stock to be used by the print service (becomes a Spool).
  OPEN
}

enum SpoolStatus {
  OPEN
  EMPTY
}

/// Brands and filament types are managed lists: they must exist before a product can use them.
/// Product keeps the name (not an id) so existing screens read it directly; renames cascade in the action.
model Brand {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
}

model FilamentType {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
}

/// A filament SKU. stockQty = rolls on hand (Amt), avgCostSgd = weighted-average ต้นทุนต่อม้วน (Cost).
model Product {
  id           String   @id @default(cuid())
  brand        String
  type         String
  color        String
  colorHex     String?
  sku          String   @unique
  stockQty     Int      @default(0)
  reservedQty  Int      @default(0)
  avgCostSgd   Decimal  @default(0) @db.Decimal(12, 2)
  sellPriceSgd Decimal  @default(0) @db.Decimal(12, 2)
  refUrl       String?
  note         String?
  lowStockAt   Int      @default(2)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  purchaseItems PurchaseOrderItem[]
  saleItems     SaleItem[]
  movements     StockMovement[]
  spools        Spool[]

  @@index([brand, type])
}

model PurchaseOrder {
  id           String         @id @default(cuid())
  code         String         @unique
  supplier     String
  currency     Currency       @default(SGD)
  status       PurchaseStatus @default(PLACED)
  /// Actual SGD paid for the whole order (items + shipping − discount, after FX).
  totalPaidSgd Decimal?       @db.Decimal(12, 2)
  /// THB per SGD. Previews THB-priced orders before the real SGD total is known, and converts a total paid in THB.
  estRate      Decimal?       @db.Decimal(10, 4)
  trackingNo   String?
  note         String?
  orderedAt    DateTime       @default(now())
  receivedAt   DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  items PurchaseOrderItem[]
}

model PurchaseOrderItem {
  id           String   @id @default(cuid())
  poId         String
  productId    String
  qty          Int
  /// Price per roll in the order currency.
  unitPrice    Decimal  @db.Decimal(12, 2)
  /// Share of totalPaidSgd allocated to this line (set on receive).
  allocatedSgd Decimal? @db.Decimal(12, 2)
  /// ต้นทุนต่อม้วน in SGD (set on receive).
  unitCostSgd  Decimal? @db.Decimal(12, 2)

  po      PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  product Product       @relation(fields: [productId], references: [id])

  @@index([poId])
  @@index([productId])
}

model Sale {
  id           String     @id @default(cuid())
  code         String     @unique
  status       SaleStatus
  customerName String?
  phone        String?
  deposit      Decimal?   @db.Decimal(12, 2)
  dueDate      DateTime?
  subtotal     Decimal    @db.Decimal(12, 2)
  discount     Decimal    @default(0) @db.Decimal(12, 2)
  total        Decimal    @db.Decimal(12, 2)
  /// Sum of item cost at the time the sale completed.
  costTotal    Decimal?   @db.Decimal(12, 2)
  note         String?
  createdAt    DateTime   @default(now())
  completedAt  DateTime?

  items SaleItem[]

  @@index([status, createdAt])
}

model SaleItem {
  id          String   @id @default(cuid())
  saleId      String
  productId   String
  qty         Int
  unitPrice   Decimal  @db.Decimal(12, 2)
  unitCostSgd Decimal? @db.Decimal(12, 2)

  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([saleId])
}

model StockMovement {
  id          String       @id @default(cuid())
  productId   String
  kind        MovementKind
  qty         Int
  unitCostSgd Decimal?     @db.Decimal(12, 2)
  refType     String?
  refId       String?
  note        String?
  createdAt   DateTime     @default(now())

  product Product @relation(fields: [productId], references: [id])

  @@index([productId, createdAt])
}

/// How a roll of one brand + type weighs: filament on a full roll, the empty reel, and density (g/cm³).
/// Reels differ by brand and filament by type, so every weight sum uses the spool's own numbers (lib/spool.ts).
model SpoolSpec {
  id          String   @id @default(cuid())
  brand       String
  type        String
  netG        Int      @default(1000)
  tareG       Int
  densityGcm3 Decimal  @db.Decimal(4, 2)
  updatedAt   DateTime @updatedAt

  @@unique([brand, type])
}

/// One physical roll used by the print service (filament2go), labelled with a QR code of its serial.
/// Remaining filament = lastGrossG − tareG. Weights are grams on the scale, reel included.
model Spool {
  id          String      @id @default(cuid())
  serial      String      @unique
  productId   String
  status      SpoolStatus @default(OPEN)
  netG        Int
  tareG       Int
  densityGcm3 Decimal     @db.Decimal(4, 2)
  startGrossG Int
  lastGrossG  Int
  /// ต้นทุนต่อม้วน when opened; cost per gram = unitCostSgd / netG.
  unitCostSgd Decimal     @db.Decimal(12, 2)
  note        String?
  openedAt    DateTime    @default(now())
  emptiedAt   DateTime?

  product Product      @relation(fields: [productId], references: [id])
  usages  SpoolUsage[]

  @@index([status, openedAt])
  @@index([productId])
}

/// One print job's weigh-in. afterG is null while the job is running.
model SpoolUsage {
  id        String    @id @default(cuid())
  spoolId   String
  beforeG   Int
  afterG    Int?
  usedG     Int?
  /// Slicer estimate, to compare with what was actually used.
  slicerG   Int?
  jobRef    String?
  costSgd   Decimal?  @db.Decimal(12, 2)
  note      String?
  startedAt DateTime  @default(now())
  endedAt   DateTime?

  spool Spool @relation(fields: [spoolId], references: [id], onDelete: Cascade)

  @@index([spoolId, startedAt])
  @@index([endedAt])
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  /// scrypt "salt:hash" (see lib/password.ts)
  passwordHash String
  role         Role     @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

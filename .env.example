# Postgres connection (docker compose up -d → the URL below, or a Neon/Supabase URL)
DATABASE_URL="postgres://postgres:postgres@localhost:5432/3d2go"
# Set to 1 when using `npx prisma dev` (its local server accepts one connection at a time)
# DATABASE_POOL_MAX=1

# Signs login cookies. Generate with: openssl rand -hex 32
SESSION_SECRET=""

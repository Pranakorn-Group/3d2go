# Postgres connection (docker compose up -d → the URL below, or a Neon/Supabase URL)
DATABASE_URL="postgres://postgres:postgres@localhost:5432/3d2go"
# Neon: DATABASE_URL is the pooled string (-pooler host), DIRECT_URL the direct one (used for migrations)
# DIRECT_URL="postgresql://user:pass@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
# Set to 1 when using `npx prisma dev` (its local server accepts one connection at a time)
# DATABASE_POOL_MAX=1

# Signs login cookies. Generate with: openssl rand -hex 32
SESSION_SECRET=""

# PayNow QR in the POS: your PayNow mobile (+65…) or UEN, and the name shown on the QR (optional)
PAYNOW_PROXY="+6512345678"
PAYNOW_NAME="NA"
